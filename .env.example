# =============================================================================
# ManharEvent — environment template. Copy to .env.local; never commit .env*.
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is readable by anyone
# who opens devtools. Nothing that grants access may carry that prefix — if a
# value would let someone mint a pass, refund an order or read another tenant,
# it belongs on the server side of this file with no prefix.
# =============================================================================

# =============================================================================
# App URLs — public by design (NEXT_PUBLIC_*)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public booking site, read by the dashboard (Preview, Publish) and marketing (provisioned, footer)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_SCANNER_URL=http://localhost:3002
NEXT_PUBLIC_MARKETING_URL=http://localhost:3003

# =============================================================================
# Everything below this line is NOT needed until 05-execution P-02+
# Leave these commented out during the frontend-first build (FE-00 … FE-07)
# =============================================================================

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=                     # not needed until 05-execution P-02+
# NEXT_PUBLIC_SUPABASE_ANON_KEY=                # not needed until 05-execution P-02+
# SUPABASE_SERVICE_ROLE_KEY=                    # not needed until 05-execution P-02+
# SUPABASE_JWT_SECRET=                          # not needed until 05-execution P-02+

# Razorpay
# RAZORPAY_KEY_ID=                              # not needed until 05-execution P-02+
# RAZORPAY_KEY_SECRET=                          # not needed until 05-execution P-02+
# RAZORPAY_WEBHOOK_SECRET=                      # not needed until 05-execution P-02+
# NEXT_PUBLIC_RAZORPAY_KEY_ID=                  # not needed until 05-execution P-02+

# WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=                     # not needed until 05-execution P-02+
# WHATSAPP_ACCESS_TOKEN=                        # not needed until 05-execution P-02+
# WHATSAPP_BUSINESS_ACCOUNT_ID=                 # not needed until 05-execution P-02+
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=                # not needed until 05-execution P-02+

# SMS / Email
# MSG91_AUTH_KEY=                               # not needed until 05-execution P-02+
# MSG91_SENDER_ID=                              # not needed until 05-execution P-02+
# RESEND_API_KEY=                               # not needed until 05-execution P-02+

# Infra
# UPSTASH_REDIS_REST_URL=                       # not needed until 05-execution P-02+
# UPSTASH_REDIS_REST_TOKEN=                     # not needed until 05-execution P-02+
# TURNSTILE_SITE_KEY=                           # not needed until 05-execution P-02+
# TURNSTILE_SECRET_KEY=                         # not needed until 05-execution P-02+

# Observability
# NEXT_PUBLIC_POSTHOG_KEY=                      # not needed until 05-execution P-02+
# NEXT_PUBLIC_POSTHOG_HOST=                     # not needed until 05-execution P-02+
# SENTRY_DSN=                                   # not needed until 05-execution P-02+
# SENTRY_AUTH_TOKEN=                            # not needed until 05-execution P-02+

# Security — server-only, never NEXT_PUBLIC_*
# PASS_SIGNING_SECRET=                          # signs pass QR payloads; the gate device gets a PUBLIC verify key, never this
# GATE_CODE_SECRET=                             # replaces the demo SIGNING_SECRET currently hardcoded in packages/domain/src/logic/gate-access.ts
# CRON_SECRET=                                  # not needed until 05-execution P-02+

# =============================================================================
# Content-Security-Policy
# The four apps ship CSP in Report-Only mode (see each app's next.config.ts).
# Point this at a collector to see what a strict policy would have blocked
# before switching it to enforcing.
# =============================================================================
# CSP_REPORT_URI=                               # e.g. https://o0.ingest.sentry.io/api/…/security/?sentry_key=…
